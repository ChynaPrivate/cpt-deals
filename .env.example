# ============================================================================
# Gardens Specials — environment variables
# Copy to .env.local for development. Never commit real values.
# ============================================================================

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key. Safe in browser code — row-level security is
# what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site URL, used for SEO and social-sharing metadata.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app

# ----------------------------------------------------------------------------
# The Instagram sweep — optional, and switched off until all three are set.
#
# A scheduled Netlify Function reads listed venues' recent Instagram posts
# through Meta's Business Discovery API and files anything that looks like an
# offer into the research queue. It never publishes anything.
#
# These are server-side only. Set them in the Netlify UI, not in a
# NEXT_PUBLIC_ variable and never in client code. Leave them unset and the
# function exits quietly; everything else works as normal.

# Your own Instagram Professional account's ID (the caller, not the venues).
IG_BUSINESS_ID=

# Long-lived access token for the linked Facebook Page.
IG_ACCESS_TOKEN=

# The service-role key bypasses row-level security completely, so it lives
# only here, only server-side. The scheduled sweep runs with no user session
# and is the one job in this project that genuinely needs it. Nothing in the
# browser bundle reads it.
SUPABASE_SERVICE_ROLE_KEY=
